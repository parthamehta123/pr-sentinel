# ---------------------------------------------------------------------------
# pr-sentinel configuration. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------

APP_ENV=dev
LOG_LEVEL=INFO

# --- GitHub -----------------------------------------------------------------
# Shared secret you set when creating the webhook. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=change-me
# Fine-grained PAT with: Pull requests (read/write), Contents (read).
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- Datastore (single Postgres spine: relational + vector + timeseries) -----
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5434/sentinel
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Queue ------------------------------------------------------------------
REDIS_URL=redis://localhost:6381/0

# --- LLM --------------------------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Per-agent model routing. Cost is the reason these differ; see docs/adr/0005.
MODEL_SECURITY=claude-opus-5
MODEL_CORRECTNESS=claude-opus-5
MODEL_TESTS=claude-sonnet-5
MODEL_DOCS=claude-haiku-4-5

# --- Embeddings -------------------------------------------------------------
# "hash"   -> deterministic local feature-hashing embedder. No API key, runs
#             offline, materially weaker recall. Fine for dev and CI.
# "openai" -> text-embedding-3-small/large. Set OPENAI_API_KEY.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
# MUST match the vector(N) column width in migrations/002_semantic.sql.
# Startup refuses to boot on a mismatch.
EMBEDDING_DIM=1536
OPENAI_API_KEY=

# --- Confidence gate --------------------------------------------------------
# Below this overall confidence the whole review goes to a human instead of GitHub.
AUTO_POST_CONFIDENCE=0.70
# Individual findings under this are never posted, even on an auto-posted review.
FINDING_POST_CONFIDENCE=0.60
# Never disclose a critical security finding in a public PR thread.
ESCALATE_CRITICAL_SECURITY=true

# --- Budget -----------------------------------------------------------------
DAILY_COST_CAP_USD=25.0
REVIEW_COST_CAP_USD=1.50

# --- Timeouts (seconds) -----------------------------------------------------
LLM_TIMEOUT_S=180
AGENT_TIMEOUT_S=240
GITHUB_TIMEOUT_S=20
DB_TIMEOUT_S=15

# --- Retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=12
MAX_DIFF_BYTES=400000
